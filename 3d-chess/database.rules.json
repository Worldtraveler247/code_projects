{
  "rules": {
    ".read": false,
    ".write": false,

    "current_match": {
      ".read": "auth != null",
      ".write": false
    },

    "games": {
      "$gameId": {
        ".read": "auth != null",
        ".write": "auth != null && !data.exists() && newData.child('players/w').val() === auth.uid",
        ".validate": "$gameId.matches(/^[A-Za-z0-9_-]{22}$/) && newData.hasChildren(['players', 'state', 'createdAt'])",

        "createdAt": {
          ".validate": "newData.isNumber() && (newData.val() === now || newData.val() === data.val())"
        },

        "players": {
          "w": {
            ".validate": "newData.isString() && newData.val() === auth.uid"
          },
          "b": {
            ".write": "auth != null && !data.exists() && root.child('games/' + $gameId).exists() && root.child('games/' + $gameId + '/players/w').val() !== auth.uid",
            ".validate": "newData.isString() && newData.val() === auth.uid && newData.parent().child('w').val() !== auth.uid"
          },
          "$other": { ".validate": false }
        },

        "state": {
          ".write": "auth != null && data.exists() && root.child('games/' + $gameId + '/players/' + data.child('turn').val()).val() === auth.uid",
          ".validate": "newData.hasChildren(['fen', 'turn', 'updatedAt']) && newData.child('fen').val().contains(' ' + newData.child('turn').val() + ' ') && (data.exists() ? newData.child('turn').val() !== data.child('turn').val() : (newData.child('turn').val() === 'w' && newData.child('fen').val() === 'rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1'))",
          "fen":       { ".validate": "newData.isString() && newData.val().length <= 100 && newData.val().matches(/^[1-8pnbrqkPNBRQK\\/]+ [wb] (-|[KQkq]{1,4}) (-|[a-h][36]) [0-9]{1,3} [0-9]{1,4}$/)" },
          "turn":      { ".validate": "newData.val() === 'w' || newData.val() === 'b'" },
          "lastMove":  { ".validate": "newData.isString() && newData.val().length <= 10" },
          "updatedAt": { ".validate": "newData.val() === now" },
          "$other":    { ".validate": false }
        },

        "names": {
          "$seat": {
            ".write": "auth != null && root.child('games/' + $gameId + '/players/' + $seat).val() === auth.uid",
            ".validate": "($seat === 'w' || $seat === 'b') && newData.isString() && newData.val().length <= 24 && newData.parent().parent().child('players/' + $seat).val() === auth.uid"
          }
        },

        "comments": {
          "$seat": {
            ".write": "auth != null && root.child('games/' + $gameId + '/players/' + $seat).val() === auth.uid",
            ".validate": "($seat === 'w' || $seat === 'b') && newData.isString() && newData.val().length <= 500 && newData.parent().parent().child('players/' + $seat).val() === auth.uid"
          }
        },

        "$other": { ".validate": false }
      }
    }
  }
}
